TZ=Asia/Tokyo

# Discord credential（秘密情報）
DISCORD_BOT_TOKEN=

# Discord configuration
DISCORD_APPLICATION_ID=
# Discord server ID where slash commands are registered
DISCORD_GUILD_ID=
DISCORD_NOTICE_CHANNEL_ID=
# Discord role ID to mention when a poll is posted
DISCORD_MENTION_ROLE_ID=

# Google credential（秘密情報）
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google configuration
GOOGLE_SPREADSHEET_ID=
# URL末尾の gid。例: .../edit#gid=0 の場合は 0
GOOGLE_RECORDING_SCHEDULE_SHEET_GID=

# Editing schedule tab gids (the number after #gid= in each tab URL).
GOOGLE_EDITING_SCHEDULE_SHEET_GID=
GOOGLE_EDITING_SCHEDULE_ASSIGN_ORDER_SHEET_GID=
GOOGLE_USERS_SHEET_GID=
# Parent folder containing source videos for the editing schedule.
GOOGLE_EDITING_SOURCE_FOLDER_ID=
